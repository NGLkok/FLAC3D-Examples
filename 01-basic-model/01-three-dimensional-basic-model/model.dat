; ==================================================
; 案例 01：三维基础模型
; 功能：建立规则三维长方体网格
; 模型尺寸：20 m × 12 m × 16 m
; 网格数量：10 × 6 × 8 = 480
; ==================================================

; 1. 新建模型
model new

; 2. 设置模型名称
model title 'Case 01 - 3D Basic Model'

; 3. 创建三维长方体网格
zone create brick size 10,6,8 ...
    point 0 (0,0,0) ...
    point 1 (20,0,0) ...
    point 2 (0,12,0) ...
    point 3 (0,0,16) ...
    group 'rock'

; 4. 保存模型
model save '01_three_dimensional_basic_model'
